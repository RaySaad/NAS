<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Wizard 1: accounts + date range  -->
    <record id="full_employee_statement_wizard_view_form" model="ir.ui.view">
        <field name="name">full.employee.statement.wizard.form</field>
        <field name="model">full.employee.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Full Employee Statement">
                <group>
                    <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate_statement" string="Generate Statement" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <!--  Wizard 2: results  -->
    <record id="full_employee_statement_wizard_view_result_form" model="ir.ui.view">
        <field name="name">full.employee.statement.wizard.result.form</field>
        <field name="model">full.employee.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Full Employee Statement">
                <sheet>
                    <group>
                        <group>
                            <field name="account_ids" widget="many2many_tags" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="total_balance"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="employee_code" string="Employee ID"/>
                                    <field name="account_id" string="Account"/>
                                    <field name="opening_balance" sum="Opening Balance"/>
                                    <field name="debit" sum="Debit"/>
                                    <field name="credit" sum="Credit"/>
                                    <field name="net_diff" sum="Net Diff."/>
                                    <field name="balance" sum="Balance"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Print" type="object" class="btn-secondary"/>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_full_employee_statement" model="ir.actions.act_window">
        <field name="name">Full Employee Statement</field>
        <field name="res_model">full.employee.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="full_employee_statement_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>