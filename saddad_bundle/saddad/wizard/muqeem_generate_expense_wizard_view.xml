<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="muqeem_generate_expense_wizard_form_view" model="ir.ui.view">
        <field name="name">muqeem.generate.expense.wizard.form.view</field>
        <field name="model">muqeem.generate.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Expenses">
                <group>
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="date" readonly="1"/>
                    </group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="iqama_period" readonly="1"/>
                    </group>
                </group>
                <separator string="Employees - Pending Payment"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="employee_id"/>
                        <field name="identification_id"/>
                        <field name="iqama_expiry_date" optional="hide"/>
                        <field name="employee_code"/>
                        <field name="expense_id" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>