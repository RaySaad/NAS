<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_ext_form_own" model="ir.ui.view">
        <field name="name">hr.employee.ext.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <!-- 18.0 displayed the job title below the name and the avatar on
                 the right. Restore that header without creating another field. -->
            <xpath expr="//form/sheet/div[div[hasclass('o_employee_avatar')]]" position="attributes">
                <attribute name="class">d-flex flex-row align-items-start justify-content-between gap-3 mb-3</attribute>
            </xpath>
            <xpath expr="//form/sheet/div[div[hasclass('o_employee_avatar')]]/div[div[hasclass('oe_title')]]" position="attributes">
                <attribute name="class">flex-grow-1 mw-100 p-0</attribute>
                <attribute name="style">min-width: 0;</attribute>
            </xpath>
            <xpath expr="//form/sheet//div[hasclass('oe_title')]/h1" position="after">
                <h2 name="nas_employee_header_job_title" class="mb-0 fw-normal fs-4">
                    <field name="job_title" placeholder="Job Title" class="d-block text-break" />
                </h2>
            </xpath>
            <xpath expr="//form/sheet/div[div[hasclass('o_employee_avatar')]]/div[hasclass('o_presence_status_pill_wrapper')]" position="after">
                <xpath expr="//form/sheet/div/div[hasclass('o_employee_avatar')]" position="move" />
            </xpath>
            <xpath expr="//form/sheet/div/div[hasclass('o_employee_avatar')]" position="attributes">
                <attribute name="class">o_employee_avatar flex-shrink-0 p-0 ms-auto</attribute>
                <attribute name="style">width: 90px;</attribute>
            </xpath>
            <xpath expr="//form/sheet/div/div[hasclass('o_employee_avatar')]/field[@name='image_1920']" position="attributes">
                <attribute name="options">{'size': [90, 90], 'zoom': True, 'preview_image': 'avatar_128', 'img_class': 'border rounded object-fit-contain'}</attribute>
            </xpath>
            <!-- The 19.0 phone fields live in header h5 elements, not groups.
                 Use a real details group so custom fields retain their labels. -->
            <xpath expr="//form/sheet/field[@name='employee_properties']" position="before">
                <group name="nas_employee_details">
                    <group name="nas_employee_contact_details">
                        <field name="employee_code" />
                        <field name="employee_section" />
                        <field name="customer_account" />
                        <field name="project_code" />
                        <field name="job_number" />
                    </group>
                    <group name="nas_employee_work_details">
                        <field name="border_number" />
                        <field name="operating_unit_id" />
                        <field name="country_code" />
                        <field name="company_country_code" />
                        <field name="arrival_date" />
                        <field name="employee_type" />
                        <field name="profession_id" />
                        <field name="identification_id" string="Iqama No" />
                        <field name="project_joining_date" />
                        <field name="crm_id" readonly="1" />
                        <field name="user_name" readonly="1" groups="hr.group_hr_manager" />
                        <field name="coach_id" widget="many2one_avatar_employee" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//group[@name='nas_employee_contact_details']/field[@name='employee_code']" position="before">
                <xpath expr="//form/sheet//h5/field[@name='work_email']" position="move" />
                <xpath expr="//form/sheet//h5/field[@name='work_phone']" position="move" />
            </xpath>
            <xpath expr="//group[@name='nas_employee_contact_details']/field[@name='job_number']" position="after">
                <xpath expr="//form/sheet//h5/field[@name='mobile_phone']" position="move" />
                <xpath expr="//form/sheet//h5/field[@name='category_ids']" position="move" />
            </xpath>
            <xpath expr="//group[@name='nas_employee_work_details']/field[@name='border_number']" position="before">
                <xpath expr="//div[@id='o_work_information']/group/field[@name='department_id']" position="move" />
            </xpath>
            <xpath expr="//group[@name='nas_employee_work_details']/field[@name='project_joining_date']" position="after">
                <xpath expr="//div[@id='o_work_information']/group/field[@name='job_title']" position="move" />
            </xpath>
            <xpath expr="//group[@name='nas_employee_work_details']/field[@name='coach_id']" position="before">
                <xpath expr="//div[@id='o_work_information']/group/field[@name='job_id']" position="move" />
                <xpath expr="//div[@id='o_work_information']/group/field[@name='parent_id']" position="move" />
            </xpath>
            <xpath expr="//form/sheet//h5[i[hasclass('fa-envelope')]]" position="replace" />
            <xpath expr="//form/sheet//h5[i[hasclass('fa-phone')]]" position="replace" />
            <xpath expr="//form/sheet//h5[i[hasclass('fa-mobile')]]" position="replace" />
            <xpath expr="//form/sheet//h5[i[hasclass('fa-tags')]]" position="replace" />
            <!-- Keep familiar navigation without replacing 19.0 contract,
                 bank-allocation, salary-adjustment or approver workflows. -->
            <xpath expr="//form/sheet/notebook/page[@name='work_information']" position="before">
                <xpath expr="//form/sheet/notebook/page[@name='resume']" position="move" />
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='work_information']" position="attributes">
                <attribute name="string">Work Information</attribute>
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='personal_information']" position="attributes">
                <attribute name="string">Private Information</attribute>
            </xpath>
            <xpath expr="//page[@name='hr_settings']//group[@name='user']" position="attributes">
                <attribute name="string">Status</attribute>
            </xpath>
            <xpath expr="//page[@name='hr_settings']//group[@name='user']/label[@for='user_id']" position="before">
                <xpath expr="//page[@name='payroll_information']//field[@name='employee_type']" position="move" />
            </xpath>
            <xpath expr="//page[@name='personal_information']//group[@name='citizenship']/field[@name='identification_id']" position="attributes">
                <attribute name="string">Iqama No</attribute>
            </xpath>
            <!-- These native fields still exist in 19.0 but were omitted
                 from its employee form. Keep the old data editable. -->
            <xpath expr="//page[@name='personal_information']//group[@name='hr_education_group']/field[@name='study_field']" position="after">
                <field name="study_school" />
            </xpath>
            <xpath expr="//page[@name='personal_information']//group[@name='hr_location_group']" position="inside">
                <field name="private_car_plate" string="Private Car Plate" />
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='private_email']" position="attributes">
                <attribute name="string">Private Email</attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information']//field[@name='private_phone']" position="attributes">
                <attribute name="string">Private Phone</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_department_ext_form" model="ir.ui.view">
        <field name="name">hr.department.ext.form</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="crm_id" readonly="1" />
                <field name="user_name" readonly="1" groups="hr.group_hr_manager" />
            </xpath>
        </field>
    </record>
</odoo>
