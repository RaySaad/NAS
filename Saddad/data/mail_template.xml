<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1"><record id="mail_template_ptr_approval" model="mail.template">
<field name="name">Saddad: PTR Approval Required</field><field name="model_id" ref="model_saddad_ptr"/>
<field name="subject">PTR approval required: {{ object.name }}</field>
<field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field>
<field name="auto_delete" eval="True"/><field name="body_html" type="html">
<div><p>A Pending to Renew request requires your approval.</p><p><t t-out="object.name"/> — <t t-out="object.employee_id.name"/></p>
<p><a t-att-href="object.get_base_url() + '/odoo/saddad.ptr/' + str(object.id)">Open PTR</a></p></div>
</field></record></data>
</odoo>
