<odoo>
  <data noupdate="1">
    <record id="sequence_morro" model="ir.sequence">
      <field name="name">Morro Expense</field>
      <field name="code">saddad.morro</field>
      <field name="prefix">MOR/%(year)s/</field>
      <field name="padding">6</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="approval_morro_submit" model="saddad.approval.rule">
      <field name="name">Morro Submit</field>
      <field name="transition">morro_submit</field>
      <field name="group_id" ref="group_morro_user"/>
    </record>
    <record id="approval_morro_fleet" model="saddad.approval.rule">
      <field name="name">Morro Fleet</field>
      <field name="transition">morro_fleet</field>
      <field name="group_id" ref="group_morro_fleet"/>
    </record>
    <record id="approval_morro_finance" model="saddad.approval.rule">
      <field name="name">Morro Finance</field>
      <field name="transition">morro_finance</field>
      <field name="group_id" ref="group_morro_finance"/>
    </record>
    <record id="approval_morro_gm" model="saddad.approval.rule">
      <field name="name">Morro Gm</field>
      <field name="transition">morro_gm</field>
      <field name="group_id" ref="group_morro_gm"/>
    </record>
    <record id="approval_morro_payment" model="saddad.approval.rule">
      <field name="name">Morro Payment</field>
      <field name="transition">morro_payment</field>
      <field name="group_id" ref="group_payment"/>
    </record>
    <record id="approval_morro_post" model="saddad.approval.rule">
      <field name="name">Morro Post</field>
      <field name="transition">morro_post</field>
      <field name="group_id" ref="group_morro_post"/>
    </record>
    <record id="approval_morro_reset" model="saddad.approval.rule">
      <field name="name">Morro Reset</field>
      <field name="transition">morro_reset</field>
      <field name="group_id" ref="group_morro_user"/>
    </record>
    <record id="activity_morro" model="mail.activity.type">
      <field name="name">Morro Approval</field>
      <field name="res_model">saddad.morro</field>
      <field name="icon">fa-check-square-o</field>
    </record>
    <record id="mail_template_morro" model="mail.template">
      <field name="name">Saddad: Morro Action Required</field>
      <field name="model_id" ref="model_saddad_morro"/>
      <field name="subject">Morro action required: {{ object.name }}</field>
      <field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html" type="html">
        <div>
          <p>A Morro expense requires your action.</p>
          <p>
            <t t-out="object.name"/>
          </p>
          <p>
            <a t-att-href="object.get_base_url() + &quot;/odoo/saddad.morro/&quot; + str(object.id)">Open Morro Expense</a>
          </p>
        <p>Current stage: <t t-out="object._stage_label()"/></p></div>
      </field>
    </record>
  </data>
</odoo>
