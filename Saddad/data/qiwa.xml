<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
<record id="sequence_qiwa" model="ir.sequence"><field name="name">Qiwa Batch</field><field name="code">saddad.qiwa.batch</field><field name="prefix">QIW/%(year)s/</field><field name="padding">6</field><field name="company_id" eval="False"/></record>
<record id="approval_qiwa_review" model="saddad.approval.rule"><field name="name">Default Qiwa Review</field><field name="transition">qiwa_review</field><field name="group_id" ref="group_user"/></record>
<record id="approval_qiwa_confirm" model="saddad.approval.rule"><field name="name">Default Qiwa Confirmation</field><field name="transition">qiwa_confirm</field><field name="group_id" ref="group_confirmer"/></record>
<record id="approval_qiwa_reset" model="saddad.approval.rule"><field name="name">Default Qiwa Reset</field><field name="transition">qiwa_reset</field><field name="group_id" ref="group_user"/></record>
<record id="activity_qiwa_approval" model="mail.activity.type"><field name="name">Qiwa Approval</field><field name="res_model">saddad.qiwa.batch</field><field name="icon">fa-check-square-o</field></record>
<record id="mail_template_qiwa_approval" model="mail.template"><field name="name">Saddad: Qiwa Approval Required</field><field name="model_id" ref="model_saddad_qiwa_batch"/><field name="subject">Qiwa approval required: {{ object.name }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field><field name="auto_delete" eval="True"/><field name="body_html" type="html"><div><p>A Qiwa batch requires your approval.</p><p><t t-out="object.name"/></p><p><a t-att-href="object.get_base_url() + '/odoo/saddad.qiwa.batch/' + str(object.id)">Open Qiwa Batch</a></p></div></field></record>
</data></odoo>