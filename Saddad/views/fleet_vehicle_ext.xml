<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="saddad_fleet_vehicle_view_form_ext" model="ir.ui.view">
            <field name="name">saddad.fleet.vehicle.form</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" icon="fa-ticket"
                            name="action_open_morror">
                        <field name="morro_count" string="Morror" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>