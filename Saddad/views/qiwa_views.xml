<odoo>
<record id="view_qiwa_list" model="ir.ui.view"><field name="name">saddad.qiwa.batch.list</field><field name="model">saddad.qiwa.batch</field><field name="arch" type="xml"><list decoration-success="state == 'confirmed'" decoration-info="state == 'reviewed'"><header><button name="action_review" type="object" string="Review" /><button name="action_confirm" type="object" string="Confirm" /></header><field name="name" /><field name="reference" /><field name="issue_date" /><field name="due_date" /><field name="period" optional="show" /><field name="company_id" groups="base.group_multi_company" /><field name="currency_id" column_invisible="True" /><field name="total_amount" sum="Total Amount" /><field name="state" widget="badge" /><field name="downstream_state" optional="show" /></list></field></record>
<record id="view_qiwa_form" model="ir.ui.view"><field name="name">saddad.qiwa.batch.form</field><field name="model">saddad.qiwa.batch</field><field name="arch" type="xml"><form><header>
<button name="action_request_review" type="object" string="Request Review" invisible="state != 'draft'" />
<button name="action_review" type="object" string="Review" class="oe_highlight" invisible="not can_review" />
<button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="not can_confirm" />
<button name="action_reset_draft" type="object" string="Reset to Draft" invisible="not can_reset" />
<button name="action_import_pdf" type="object" string="Import Qiwa PDF" invisible="state != 'draft'" />
<field name="can_review" invisible="True" /><field name="can_confirm" invisible="True" /><field name="can_reset" invisible="True" /><field name="state" widget="statusbar" statusbar_visible="draft,reviewed,confirmed" /><button name="action_prepare_muqeem" type="object" string="Prepare Muqeem" invisible="state != 'confirmed' or downstream_state != 'pending'" /><button name="action_open_muqeem" type="object" string="Muqeem Expense" invisible="downstream_state not in ['linked','posted']" /></header>
<sheet><div class="oe_title"><h1><field name="name" /></h1></div><group><group><field name="company_id" readonly="id" groups="base.group_multi_company" /><field name="reference" readonly="state != 'draft'" /><field name="invoice_number" readonly="state != 'draft'" /><field name="issue_date" readonly="state != 'draft'" /><field name="due_date" readonly="state != 'draft'" invisible="document_payment_status == 'paid'" /><field name="document_payment_status" readonly="state != 'draft'" /><field name="document_payment_date" readonly="state != 'draft'" invisible="document_payment_status != 'paid'" /><field name="document_export_date" readonly="state != 'draft'" /></group><group><field name="period" readonly="state != 'draft'" /><field name="currency_id" invisible="True" /><field name="total_amount" /><field name="downstream_state" /></group></group>
<notebook><page string="Employee Lines"><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="company_id" column_invisible="True" /><field name="currency_id" column_invisible="True" /><field name="employee_id" readonly="ptr_line_id" domain="[('company_id','=',parent.company_id)]" /><field name="iqama_number" /><field name="mapping_id" readonly="ptr_line_id" domain="[('company_id','=',parent.company_id),('service_type','=','work_permit')]" /><field name="product_id" optional="hide" /><field name="period" /><field name="permit_valid_until" optional="show" /><field name="amount_source" /><field name="amount" readonly="amount_source != 'external'" sum="Total Amount" /><field name="external_reason" optional="show" required="amount_source == 'external'" /><field name="ptr_line_id" column_invisible="True" /><field name="ptr_id" optional="show" /><field name="downstream_state" optional="hide" /></list></field></page>
<page string="Notes"><field name="notes" readonly="state != 'draft'" /></page><page string="Approval History"><group><field name="reviewed_by" /><field name="reviewed_at" /><field name="confirmed_by" /><field name="confirmed_at" /></group></page></notebook></sheet><chatter /></form></field></record>
<record id="view_qiwa_search" model="ir.ui.view"><field name="name">saddad.qiwa.batch.search</field><field name="model">saddad.qiwa.batch</field><field name="arch" type="xml"><search><field name="name" /><field name="reference" /><field name="line_ids" string="Employee" filter_domain="[('line_ids.employee_id','ilike',self)]" /><filter name="draft" string="Draft" domain="[('state','=','draft')]" /><filter name="reviewed" string="Reviewed" domain="[('state','=','reviewed')]" /><filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]" /><group><filter name="by_state" string="Status" context="{'group_by':'state'}" /><filter name="by_company" string="Company" context="{'group_by':'company_id'}" /></group></search></field></record>
<record id="action_qiwa" model="ir.actions.act_window"><field name="name">Qiwa Work Permit Batches</field><field name="res_model">saddad.qiwa.batch</field><field name="view_mode">list,form</field></record>
<record id="view_ptr_qiwa" model="ir.ui.view"><field name="name">saddad.ptr.qiwa</field><field name="model">saddad.ptr</field><field name="inherit_id" ref="view_ptr_form" /><field name="arch" type="xml"><xpath expr="//field[@name='qiwa_handoff_state']" position="before"><field name="qiwa_batch_id" readonly="state != 'draft'" domain="[('company_id','=',company_id),('state','=','draft')]" options="{'no_create':True}" /></xpath><xpath expr="//header" position="inside"><button name="action_prepare_qiwa" type="object" string="Prepare Qiwa Batch" invisible="state != 'confirmed' or qiwa_handoff_state != 'pending'" /></xpath></field></record>
<record id="view_qiwa_import" model="ir.ui.view"><field name="name">saddad.qiwa.import.form</field><field name="model">saddad.qiwa.import</field><field name="arch" type="xml"><form string="Qiwa PDF Assistance"><group><field name="batch_id" /><field name="filename" invisible="True" /><field name="pdf_file" filename="filename" /><field name="reference" /><field name="invoice_number" /><field name="issue_date" /><field name="due_date" invisible="document_payment_status == 'paid'" /><field name="period" /><field name="detected_currency" /><field name="document_payment_status" /><field name="document_payment_date" invisible="document_payment_status != 'paid'" /><field name="document_export_date" /><field name="document_total" invisible="not has_document_total" /><field name="currency_id" invisible="True" /><field name="has_document_total" invisible="True" /></group><div class="alert alert-info" role="alert">Check the PDF before applying. Unknown or ambiguous employees must be selected manually. Product Cost is a suggestion, not an extracted fee.</div><field name="import_summary" nolabel="1" /><field name="line_ids"><list editable="bottom"><field name="company_id" column_invisible="True" /><field name="currency_id" column_invisible="True" /><field name="source_identity" /><field name="period" /><field name="suggested_cost" /><field name="employee_id" domain="[('company_id','=',company_id)]" /><field name="amount_source" /><field name="amount" readonly="amount_source != 'external'" /><field name="permit_valid_until" /><field name="external_reason" required="amount_source == 'external'" /></list></field><div class="mt-3"><field name="reviewed" /><label for="reviewed" class="ms-2" /></div><details class="mt-3"><summary>Raw extracted text (optional)</summary><div style="max-height: 220px; overflow: auto; white-space: pre-wrap;" class="mt-2"><field name="extracted_text" /></div></details><footer><button name="action_extract" type="object" string="Extract PDF" class="btn-primary" /><button name="action_apply" type="object" string="Apply to Draft" /><button special="cancel" string="Cancel" /></footer></form></field></record>
</odoo>