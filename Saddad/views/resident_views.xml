<?xml version='1.0' encoding='UTF-8'?>
<odoo>
<record id="view_establishment_list" model="ir.ui.view"><field name="name">saddad.establishment.list</field><field name="model">saddad.establishment</field><field name="arch" type="xml"><list><field name="name"/><field name="number"/><field name="company_id"/><field name="pending_days"/><field name="warning_days"/></list></field></record>
<record id="view_establishment_form" model="ir.ui.view"><field name="name">saddad.establishment.form</field><field name="model">saddad.establishment</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="number"/><field name="company_id"/><field name="pending_days" string="Pending Renewal Alert After (Days)"/><field name="warning_days" string="Permit Expiry Warning (Days)"/></group></sheet></form></field></record>
<record id="action_establishment" model="ir.actions.act_window"><field name="name">Muqeem Establishments</field><field name="res_model">saddad.establishment</field><field name="view_mode">list,form</field></record>
<record id="view_resident_list" model="ir.ui.view"><field name="name">saddad.resident.list</field><field name="model">saddad.resident</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="employee_id"/><field name="iqama"/><field name="employer_number"/><field name="reported_expiry"/><field name="employee_expiry"/><field name="latest_permit_valid_until"/><field name="latest_permit_confirmed_on"/><field name="passport_expiry"/><field name="outside_kingdom"/><field name="snapshot_date"/><field name="company_id"/></list></field></record>
<record id="view_resident_form" model="ir.ui.view"><field name="name">saddad.resident.form</field><field name="model">saddad.resident</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_review_expiry" type="object" string="Review Employee Expiry Update"/></header><sheet><field name="expiry_comparison" invisible="1"/><div class="alert alert-warning" role="alert" invisible="expiry_comparison != 'older'">The imported expiry is older than the employee expiry. Import a fresh Muqeem report; the employee expiry is preserved.</div><group><field name="employee_id"/><field name="company_id"/><field name="establishment_id"/><field name="iqama"/><field name="employer_number"/><field name="reported_name"/><field name="sex"/><field name="nationality"/><field name="occupation"/><field name="passport"/><field name="passport_expiry"/><field name="iqama_issue"/><field name="reported_expiry"/><field name="employee_expiry"/><field name="latest_permit_valid_until"/><field name="latest_permit_confirmed_on"/><field name="reported_hijri"/><field name="birth_date"/><field name="outside_kingdom"/><field name="snapshot_date"/><field name="source_batch_id"/></group><field name="renewal_ids" readonly="1"><list><field name="original_expiry"/><field name="new_expiry"/><field name="permit_valid_until"/><field name="state"/><field name="owner_id"/></list></field></sheet><chatter/></form></field></record>
<record id="view_resident_search" model="ir.ui.view"><field name="name">saddad.resident.search</field><field name="model">saddad.resident</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="iqama"/><field name="employer_number"/><field name="passport"/><field name="establishment_id"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/></search></field></record>
<record id="action_resident" model="ir.actions.act_window"><field name="name">Muqeem Residents</field><field name="res_model">saddad.resident</field><field name="view_mode">list,form</field></record>
<record id="view_resident_import_list" model="ir.ui.view"><field name="name">saddad.resident.import.list</field><field name="model">saddad.resident.import</field><field name="arch" type="xml"><list><field name="filename"/><field name="company_id"/><field name="snapshot_date"/><field name="state"/><field name="applied_at"/></list></field></record>
<record id="view_resident_import_form" model="ir.ui.view"><field name="name">saddad.resident.import.form</field><field name="model">saddad.resident.import</field><field name="arch" type="xml"><form delete="false"><header><button name="action_preview" type="object" string="Preview Import" invisible="state != 'draft'" class="btn-primary"/><button name="action_apply" type="object" string="Apply Ready Rows" invisible="state != 'preview'" confirm="Apply the ready rows to resident profiles? Blocked rows will be skipped. Employee records will not be changed." class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" readonly="state != 'draft'"/><field name="filename" readonly="state != 'draft'"/><field name="file" filename="filename" readonly="state != 'draft'"/><field name="snapshot_date" readonly="state != 'draft'"/><field name="applied_by"/><field name="applied_at"/></group><field name="summary"/><field name="line_ids"><list create="false" edit="false" delete="false" decoration-danger="status == 'error'"><field name="row_number"/><field name="iqama"/><field name="employee_id"/><field name="proposed_expiry"/><field name="status"/><field name="detail"/></list></field></sheet><chatter/></form></field></record>
<record id="action_resident_import" model="ir.actions.act_window"><field name="name">Muqeem Resident Imports</field><field name="res_model">saddad.resident.import</field><field name="view_mode">list,form</field></record>
<record id="view_resident_expiry_form" model="ir.ui.view"><field name="name">saddad.resident.expiry.form</field><field name="model">saddad.resident.expiry</field><field name="arch" type="xml"><form string="Review Imported Muqeem Expiry"><group><field name="resident_id" readonly="1"/><field name="expected_expiry"/><field name="new_expiry"/><field name="snapshot_date"/><field name="verified"/></group><footer><button name="action_apply" string="Apply Verified Expiry" type="object" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="view_renewal_list" model="ir.ui.view"><field name="name">saddad.renewal.list</field><field name="model">saddad.renewal</field><field name="arch" type="xml"><list><field name="employee_id"/><field name="original_expiry"/><field name="new_expiry"/><field name="permit_valid_until"/><field name="permit_confirmed_on"/><field name="permit_renewal_date" readonly="permit_confirmed_on or state == 'done'"/><field name="blocker"/><field name="owner_id"/><field name="state"/></list></field></record>
<record id="view_renewal_form" model="ir.ui.view"><field name="name">saddad.renewal.form</field><field name="model">saddad.renewal</field><field name="arch" type="xml"><form delete="false"><header><button name="action_confirm_permit" type="object" string="Confirm Work Permit Renewed" invisible="state == 'done' or permit_confirmed_on" confirm="Confirm that the work permit was actually renewed on Qiwa, not merely approved or paid?"/><button name="action_confirm_renewal" type="object" string="Confirm Iqama Renewal" invisible="state == 'done'" confirm="Confirm the renewal was executed on Muqeem and the new expiry is verified?" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="resident_id" readonly="id"/><field name="company_id"/><field name="employee_id"/><field name="period" readonly="state == 'done'"/><field name="original_expiry"/><field name="new_expiry" readonly="state == 'done'"/><field name="expense_line_id" domain="[('employee_id','=',employee_id),('company_id','=',company_id)]" readonly="state == 'done'"/><field name="evidence" readonly="state == 'done'"/></group><group><field name="qiwa_line_id" domain="[('employee_id','=',employee_id),('company_id','=',company_id)]" readonly="permit_confirmed_on or state == 'done'"/><field name="permit_valid_until"/><field name="permit_evidence" readonly="permit_confirmed_on or state == 'done'"/><field name="permit_confirmed_on"/><field name="permit_renewal_date" readonly="permit_confirmed_on or state == 'done'"/><field name="owner_id" readonly="state == 'done'"/><field name="blocker" readonly="state == 'done'"/><field name="completed_at"/><field name="completed_by"/></group></group><field name="notes" readonly="state == 'done'"/></sheet><chatter/></form></field></record>
<record id="view_renewal_search" model="ir.ui.view"><field name="name">saddad.renewal.search</field><field name="model">saddad.renewal</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="owner_id"/><filter name="pending" string="Pending Renewal" domain="[('state','=','pending')]"/><filter name="stalled" string="Work Permit Renewed / Iqama Pending" domain="[('state','=','pending'),('permit_confirmed_on','!=',False)]"/><filter name="missing_validity" string="Missing Work Permit Validity" domain="[('qiwa_line_id','!=',False),('permit_valid_until','=',False)]"/><group><filter name="owner" string="Responsible HR" context="{'group_by':'owner_id'}"/><filter name="blocker" string="Blocking Reason" context="{'group_by':'blocker'}"/></group></search></field></record>
<record id="action_renewal" model="ir.actions.act_window"><field name="name">Iqama Renewal Follow-up</field><field name="res_model">saddad.renewal</field><field name="view_mode">list,form</field></record>
<record id="view_employee_resident" model="ir.ui.view"><field name="name">hr.employee.resident</field><field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page name="saddad_muqeem" string="Muqeem" groups="Saddad.group_resident_hr"><field name="saddad_resident_id" invisible="1"/><div class="alert alert-info" role="alert" invisible="saddad_resident_id">No Muqeem profile has been imported for this employee.</div><field name="saddad_muqeem_expiry_comparison" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not saddad_resident_id or saddad_muqeem_expiry_comparison != 'older'">The imported expiry is older than the employee expiry. Import a fresh Muqeem report; the employee expiry is preserved.</div><group invisible="not saddad_resident_id"><group string="Resident Details"><field name="saddad_muqeem_iqama" readonly="1"/><field name="saddad_muqeem_reported_name" readonly="1"/><field name="saddad_muqeem_sex" readonly="1"/><field name="saddad_muqeem_nationality" readonly="1"/><field name="saddad_muqeem_occupation" readonly="1"/><field name="saddad_muqeem_birth_date" readonly="1"/><field name="saddad_muqeem_outside_kingdom" readonly="1"/></group><group string="Employer and Report"><field name="saddad_muqeem_establishment_id" readonly="1"/><field name="saddad_muqeem_employer_number" readonly="1"/><field name="saddad_muqeem_snapshot_date" readonly="1"/></group><group string="Iqama Dates"><field name="saddad_muqeem_iqama_issue" readonly="1"/><field name="saddad_muqeem_reported_expiry" readonly="1"/><field name="saddad_muqeem_reported_hijri" readonly="1"/><field name="saddad_iqama_expiry" string="Current Employee Expiry" readonly="1"/><field name="saddad_iqama_remaining_days" readonly="1"/></group><group string="Passport and Work Permit"><field name="saddad_muqeem_passport" readonly="1"/><field name="saddad_muqeem_passport_expiry" readonly="1"/><field name="saddad_muqeem_latest_permit_valid_until" readonly="1"/><field name="saddad_muqeem_latest_permit_confirmed_on" readonly="1"/></group></group><button name="action_open_resident_profile" type="object" string="Open Muqeem Profile" invisible="not saddad_resident_id" class="oe_link"/></page></xpath></field></record>
<menuitem id="menu_residents" name="Muqeem Residents" parent="menu_muqeem_group" action="action_resident" sequence="32" groups="Saddad.group_resident_hr"/>
<menuitem id="menu_resident_import" name="Resident Imports" parent="menu_muqeem_group" action="action_resident_import" sequence="33" groups="Saddad.group_resident_hr"/>
<menuitem id="menu_renewal" name="Iqama Renewal Follow-up" parent="menu_renewals" action="action_renewal" sequence="34" groups="Saddad.group_resident_hr"/>
<menuitem id="menu_establishments" name="Muqeem Establishments" parent="menu_configuration" action="action_establishment" groups="Saddad.group_manager"/>
<data noupdate="1"><record id="cron_resident_alerts" model="ir.cron"><field name="name">Saddad: Pending Iqama Renewal Alerts</field><field name="model_id" ref="model_saddad_renewal"/><field name="state">code</field><field name="code">model._cron_alerts()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="user_id" ref="base.user_root"/></record></data>
<record id="view_qiwa_renewal_shortcut" model="ir.ui.view"><field name="name">qiwa.renewal.shortcut</field><field name="model">saddad.qiwa.batch</field><field name="inherit_id" ref="view_qiwa_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list" position="inside"><button name="action_renewal_followup" type="object" string="Renewal Follow-up" groups="Saddad.group_resident_hr" invisible="parent.state != 'confirmed'" icon="fa-calendar"/></xpath></field></record>
<record id="view_muqeem_renewal_shortcut" model="ir.ui.view"><field name="name">muqeem.renewal.shortcut</field><field name="model">saddad.muqeem.expense</field><field name="inherit_id" ref="view_muqeem_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list" position="inside"><button name="action_renewal_followup" type="object" string="Renewal Follow-up" groups="Saddad.group_resident_hr" icon="fa-calendar"/></xpath></field></record>
</odoo>
