<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_loans_advances_request_form_ext" model="ir.ui.view">
        <field name="name">loan.advance.request.form.ext</field>
        <field name="model">loan.advance.request</field>
        <field name="inherit_id" ref="hr_loans.hr_loans_advances_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="morror_id" invisible="1"/>
                <field name="muqeem_expense_id" invisible="1"/>
                <button name="action_open_morror" class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not morror_id"
                        type="object">
                    Morror
                </button>
                <button name="action_open_muqeem_expense" class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not muqeem_expense_id"
                        type="object" string="Muqeem Expense">
                </button>
            </xpath>
        </field>
    </record>
</odoo>